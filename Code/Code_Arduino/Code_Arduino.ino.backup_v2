/* ============================================================================
 *  EduExo  ·  Adaptive Stroke Rehabilitation Exoskeleton  ·  Arduino firmware
 *  Niel Boon & Senne Peeters · KU Leuven · 2026
 * ----------------------------------------------------------------------------
 *  Hardware:
 *    - ODrive S1                     (UART, axis0)            Serial1
 *    - 2x MPU-6050 IMU               (I2C, 0x68 + 0x69)       Wire
 *    - DRV2605L LRA-driver           (I2C, 0x5A · PWM op D13) Wire + Timer4
 *
 *  Architectuur:
 *    - Coöperatieve state-machine        (zie SysteemStatus)
 *    - 10 Hz telemetry-output            (POS / VEL / TRQ / STATE / IMU1 / IMU2)
 *    - Niet-blokkerende command parser   (newline-delimited, case-insensitive)
 *    - Hybride controle:
 *        · Positie-modus  voor kalibratie, presets, settings
 *        · Torque-modus   tijdens actieve therapie
 *    - Impedance-controller in torque-modus:
 *        torque = assist + damping + virtuele_veer
 *      met slew-rate-limiet en harde safety-clamp.
 *
 *  Serial protocol (115200 baud, naar dashboard, één regel per veld):
 *      POS:<deg>     elleboog-hoek (motor) t.o.v. software-nul
 *      VEL:<rev/s>   gefilterde motor-snelheid
 *      TRQ:<Nm>      huidige toegepaste torque
 *      STATE:<n>     0..5  →  zie SysteemStatus
 *      IMU1:<deg>    bovenarm pitch  (atan2 over accelerometer)
 *      IMU2:<deg>    onderarm pitch
 *
 *  Commando's IN (van dashboard, alle case-insensitive):
 *      RESET, CHANGE_SETTINGS, SAVE_DONE,
 *      gestrekt, start, stop,
 *      MODE_ASSISTIVE | MODE_RESISTIVE | MODE_FREERIDE,
 *      SET_LIM_MIN:<v>,  SET_LIM_MAX:<v>,
 *      SET_A_TORQUE:<v>, SET_A_FACTOR:<v>, SET_A_STREK:<v>,
 *      SET_T_WEERSTAND:<v>, SET_VEER:<v>, SET_MAX_KOPPEL:<v>,
 *      SET_HAPTIC:<v>,   SET_ANGLE:<v>,   SET_SHOCK:<v>,
 *      SET_POS_GAIN:<v>, SET_VEL_GAIN:<v>, SET_VEL_INT:<v>, SET_BW:<v>
 * ========================================================================== */

#include <ODriveUART.h>
#include <Wire.h>

// ============================================================================
//   1.  KINEMATIEK / HARDWARE-CONSTANTEN  (niet runtime-aanpasbaar)
// ============================================================================
static constexpr float OFFSET_NAAR_GESTREKT  = -65.0f;       // [deg] hardware-index → software 0°
static constexpr float GRADEN_NAAR_TURNS     = 1.0f / 360.0f;

static constexpr float VELOCITY_THRESHOLD    = 0.02f;        // [rev/s] dode-zone in assist
static constexpr float MAX_SAFE_VELOCITY     = 0.80f;        // [rev/s] noodstop bij overschrijding
static constexpr float SNELHEIDSFILTER       = 0.80f;        // EMA-gewicht oude waarde
static constexpr float MAX_KOPPEL_STAP       = 0.015f;       // [Nm/loop] slew-rate
static constexpr float BASIS_DAMPING         = 0.05f;        // permanente damper

// I2C-adressen
static constexpr uint8_t MPU_BOVENARM        = 0x68;
static constexpr uint8_t MPU_ONDERARM        = 0x69;
static constexpr uint8_t DRV_ADDR            = 0x5A;

// Timing
static constexpr uint32_t TELEMETRY_INTERVAL_MS = 100;       // 10 Hz
static constexpr uint32_t HAPTIC_COOLDOWN_MS    = 2500;
static constexpr uint32_t HAPTIC_PULSE_MS       = 50;

// Soft-start: tijdens deze tijd na het inschakelen van therapie wordt
// alleen lichte demping toegepast (geen assist of training-weerstand),
// zodat de patiënt + robot eerst in evenwicht komen. Voorkomt schokken
// bij het aansluiten van de exoskelet aan de arm.
static constexpr uint32_t SOFT_START_MS      = 1500;
static constexpr float    SOFT_START_DAMPING = 0.25f;

// Vibration suppression (high-pass damping):
// Wanneer de arm niet rigide aan de robot zit, of zonder arm wordt
// gebruikt, is de gecombineerde traagheid lager dan waar de impedance-
// controller op afgestemd is. Het systeem wordt dan "te scherp" en
// kan oscilleren (positive feedback van de assist-loop op kleine
// trillingen). De high-pass damping dempt automatisch de snelle
// componenten van de motor-snelheid (= het verschil tussen instant en
// LPF-gefilterde snelheid), zonder normale bewegingen te beïnvloeden:
//
//   normale beweging: fb.vel ≈ gefilterde_vel  →  hf ≈ 0  →  geen demping
//   oscillatie:       fb.vel oscilleert snel    →  hf groot →  sterke demping
//
// Werkt in alle modi (assistive, resistive, freeride) én tijdens soft-start.
// De gain zit nu in TherapieConfig (runtime aanpasbaar via SET_SHOCK).
static constexpr float    HF_DAMPING_GAIN_DEFAULT = 1.50f;

// ODrive control-modes (zie ODrive docs)
static constexpr int ODRV_MODE_TORQUE   = 1;
static constexpr int ODRV_MODE_POSITION = 3;

// ============================================================================
//   2.  THERAPIE-CONFIG  (runtime aanpasbaar via SET_*-commando's)
// ============================================================================
struct TherapieConfig {
  float assist_torque           = 0.60f;
  float assist_opbouw_factor    = 1.00f;
  float assist_strek_weerstand  = 0.40f;
  float training_weerstand      = 2.50f;
  float virtuele_veer_stijfheid = 0.10f;
  float veiligheids_koppel_max  = 1.50f;
  float limiet_min              = 0.0f;
  float limiet_max              = 100.0f;
  float haptic_kracht           = 1.00f;
  float hf_damping_gain         = HF_DAMPING_GAIN_DEFAULT;  // schok-reductie
};

// ============================================================================
//   3.  STATE
// ============================================================================
enum SysteemStatus : uint8_t {
  WACHTEN_OP_INDEX    = 0,
  WACHTEN_OP_GESTREKT = 1,
  NAAR_START_BEWEGEN  = 2,
  READY               = 3,
  THERAPIE_ACTIEF     = 4,
  SETTINGS_AANPASSEN  = 5
};

enum TherapieModus : uint8_t {
  ASSISTIVE = 0,
  RESISTIVE = 1,
  FREERIDE  = 2
};

struct RuntimeState {
  SysteemStatus status = WACHTEN_OP_INDEX;
  TherapieModus modus  = ASSISTIVE;

  // Calibratie-referenties (ODrive turn-ruimte)
  float hardware_index_turns = 0.0f;
  float software_nul_turns   = 0.0f;
  float huidige_doel_turns   = 0.0f;

  // Live signalen
  float imu1_bovenarm   = 0.0f;   // [deg]
  float imu2_onderarm   = 0.0f;   // [deg]
  float gefilterde_vel  = 0.0f;   // [rev/s]
  float huidig_koppel   = 0.0f;   // [Nm]

  // Scheduling
  uint32_t laatste_telemetry_ms = 0;
  uint32_t laatste_haptic_ms    = 0;
  uint32_t therapie_start_ms    = 0;   // moment van laatste "start"
};

// Globale instanties
ODriveUART     odrive(Serial1);
TherapieConfig cfg;
RuntimeState   st;

// ============================================================================
//   4.  FORWARD DECLARATIONS
// ============================================================================
// IMU / sensors
static void  imuInit(uint8_t adres);
static float imuReadPitchDeg(uint8_t adres);

// Telemetry / comm
static void  telemetryEmit();
static void  commandParseAndDispatch();

// State helpers
static void  setSysStatus(SysteemStatus s);
static void  softReset();

// ODrive control
static void  modeSwitchPosition();
static void  modeSwitchTorque();
static void  beweegVloeiend(float van, float naar, float duur_s);

// Therapie
static void  draaiTherapie();

// Haptic
static void  pwmD13_init();
static void  drvInit();
static void  drvWriteReg(uint8_t reg, uint8_t val);
static void  geefHaptischeTik();

// Utility
static inline float clampf(float x, float lo, float hi) {
  return (x < lo) ? lo : (x > hi) ? hi : x;
}

// ============================================================================
//   5.  SETUP  /  LOOP
// ============================================================================
void setup() {
  Serial1.begin(115200);
  Serial.begin(115200);
  Wire.begin();

  while (!Serial);    // wacht tot host de poort opent

  imuInit(MPU_BOVENARM);
  imuInit(MPU_ONDERARM);

  pwmD13_init();
  drvInit();

  // Wacht tot ODrive klaar is met self-test
  while (odrive.getState() == AXIS_STATE_UNDEFINED) delay(100);
}

void loop() {
  // --- Sample IMU's elke loop-pass (snel, ~1 kHz limited by I2C latency) ---
  st.imu1_bovenarm = imuReadPitchDeg(MPU_BOVENARM);
  st.imu2_onderarm = imuReadPitchDeg(MPU_ONDERARM);

  // --- 10 Hz telemetry naar dashboard ---
  if (millis() - st.laatste_telemetry_ms >= TELEMETRY_INTERVAL_MS) {
    telemetryEmit();
    st.laatste_telemetry_ms = millis();
  }

  // --- Inkomende commando's ---
  if (Serial.available() > 0) commandParseAndDispatch();

  // --- State-machine tick ---
  switch (st.status) {
    case WACHTEN_OP_INDEX:
      if (odrive.getState() == AXIS_STATE_IDLE) {
        st.hardware_index_turns = odrive.getFeedback().pos;
        st.huidige_doel_turns   = st.hardware_index_turns;
        setSysStatus(WACHTEN_OP_GESTREKT);
      }
      break;

    case NAAR_START_BEWEGEN: {
      modeSwitchPosition();
      st.huidige_doel_turns = odrive.getFeedback().pos;
      const float doel = st.hardware_index_turns +
                         (OFFSET_NAAR_GESTREKT * GRADEN_NAAR_TURNS);
      beweegVloeiend(st.huidige_doel_turns, doel, 2.0f);
      delay(200);
      st.software_nul_turns = doel;
      st.huidige_doel_turns = doel;
      setSysStatus(READY);
      break;
    }

    case THERAPIE_ACTIEF:
      draaiTherapie();
      break;

    case READY:
    case WACHTEN_OP_GESTREKT:
    case SETTINGS_AANPASSEN:
    default:
      // idle — wachten op input
      break;
  }
}

// ============================================================================
//   6.  TELEMETRY
// ============================================================================
static void telemetryEmit() {
  float graden = 0.0f;
  if (st.status >= READY) {
    graden = (odrive.getFeedback().pos - st.software_nul_turns) * 360.0f;
  }
  Serial.print(F("POS:"));   Serial.println(graden);
  Serial.print(F("VEL:"));   Serial.println(st.gefilterde_vel);
  Serial.print(F("TRQ:"));   Serial.println(st.huidig_koppel);
  Serial.print(F("STATE:")); Serial.println((int)st.status);
  Serial.print(F("IMU1:"));  Serial.println(st.imu1_bovenarm);
  Serial.print(F("IMU2:"));  Serial.println(st.imu2_onderarm);
}

// ============================================================================
//   7.  COMMAND PARSER  (geen heap-tabel; if/else is hier prima)
// ============================================================================
static void commandParseAndDispatch() {
  String input = Serial.readStringUntil('\n');
  input.trim();
  if (input.length() == 0) return;

  const int colon = input.indexOf(':');
  const String cmd = (colon == -1) ? input : input.substring(0, colon);
  const float  v   = (colon == -1) ? 0.0f
                                   : input.substring(colon + 1).toFloat();

  // ---- Algemene state-overgangen ------------------------------------------
  if (cmd.equalsIgnoreCase("RESET")) {
    softReset();
    return;
  }
  if (cmd.equalsIgnoreCase("CHANGE_SETTINGS")) {
    setSysStatus(SETTINGS_AANPASSEN);
    modeSwitchPosition();
    beweegVloeiend(odrive.getFeedback().pos, st.software_nul_turns, 1.5f);
    st.huidige_doel_turns = st.software_nul_turns;
    return;
  }
  if (cmd.equalsIgnoreCase("SAVE_DONE")) {
    if (st.status == SETTINGS_AANPASSEN) setSysStatus(READY);
    return;
  }
  if (cmd.equalsIgnoreCase("gestrekt")) {
    if (st.status == WACHTEN_OP_GESTREKT) setSysStatus(NAAR_START_BEWEGEN);
    return;
  }
  if (cmd.equalsIgnoreCase("start")) {
    if (st.status == READY) {
      modeSwitchTorque();
      st.therapie_start_ms = millis();   // soft-start countdown
      setSysStatus(THERAPIE_ACTIEF);
    }
    return;
  }
  if (cmd.equalsIgnoreCase("stop")) {
    modeSwitchPosition();
    setSysStatus(READY);
    return;
  }

  // ---- Modus-keuze ---------------------------------------------------------
  if (cmd.equalsIgnoreCase("MODE_ASSISTIVE")) { st.modus = ASSISTIVE; return; }
  if (cmd.equalsIgnoreCase("MODE_RESISTIVE")) { st.modus = RESISTIVE; return; }
  if (cmd.equalsIgnoreCase("MODE_FREERIDE"))  { st.modus = FREERIDE;  return; }

  // ---- Parameter-updates ---------------------------------------------------
  if (cmd.equalsIgnoreCase("SET_LIM_MIN"))     { cfg.limiet_min              = v; return; }
  if (cmd.equalsIgnoreCase("SET_LIM_MAX"))     { cfg.limiet_max              = v; return; }
  if (cmd.equalsIgnoreCase("SET_A_TORQUE"))    { cfg.assist_torque           = v; return; }
  if (cmd.equalsIgnoreCase("SET_A_FACTOR"))    { cfg.assist_opbouw_factor    = v; return; }
  if (cmd.equalsIgnoreCase("SET_A_STREK"))     { cfg.assist_strek_weerstand  = v; return; }
  if (cmd.equalsIgnoreCase("SET_T_WEERSTAND")) { cfg.training_weerstand      = v; return; }
  if (cmd.equalsIgnoreCase("SET_VEER"))        { cfg.virtuele_veer_stijfheid = v; return; }
  if (cmd.equalsIgnoreCase("SET_MAX_KOPPEL"))  { cfg.veiligheids_koppel_max  = v; return; }
  if (cmd.equalsIgnoreCase("SET_HAPTIC"))      { cfg.haptic_kracht           = v; return; }
  if (cmd.equalsIgnoreCase("SET_SHOCK"))       { cfg.hf_damping_gain         = v; return; }

  // ---- ODrive PID passthrough (runtime — niet persistent in ODrive) -------
  // Wijzigingen blijven actief tot power-cycle; jullie opgeslagen ODrive
  // defaults blijven onaangetast.
  if (cmd.equalsIgnoreCase("SET_POS_GAIN")) {
    Serial1.print(F("w axis0.controller.config.pos_gain "));
    Serial1.println(v, 4);
    return;
  }
  if (cmd.equalsIgnoreCase("SET_VEL_GAIN")) {
    Serial1.print(F("w axis0.controller.config.vel_gain "));
    Serial1.println(v, 4);
    return;
  }
  if (cmd.equalsIgnoreCase("SET_VEL_INT")) {
    Serial1.print(F("w axis0.controller.config.vel_integrator_gain "));
    Serial1.println(v, 4);
    return;
  }
  if (cmd.equalsIgnoreCase("SET_BW")) {
    Serial1.print(F("w axis0.controller.config.input_filter_bandwidth "));
    Serial1.println(v, 3);
    return;
  }

  // ---- Doelhoek (alleen vanuit READY of preset-aanloop) -------------------
  if (cmd.equalsIgnoreCase("SET_ANGLE")) {
    if (st.status >= READY && st.status != SETTINGS_AANPASSEN) {
      modeSwitchPosition();
      const float veilig = clampf(v, cfg.limiet_min, cfg.limiet_max);
      const float doel   = st.software_nul_turns + veilig * GRADEN_NAAR_TURNS;
      beweegVloeiend(odrive.getFeedback().pos, doel, 1.5f);
      st.huidige_doel_turns = doel;
      setSysStatus(READY);
    }
    return;
  }
}

// ============================================================================
//   8.  THERAPIE  —  Impedance-controller (positie + snelheid → torque)
// ============================================================================
static void draaiTherapie() {
  const ODriveFeedback fb = odrive.getFeedback();
  const float graden = (fb.pos - st.software_nul_turns) * 360.0f;

  // EMA op snelheid (rustigere torque-respons)
  st.gefilterde_vel = SNELHEIDSFILTER * st.gefilterde_vel +
                      (1.0f - SNELHEIDSFILTER) * fb.vel;

  // Run-away safety
  if (fabsf(fb.vel) > MAX_SAFE_VELOCITY) {
    st.huidig_koppel = 0.0f;
    odrive.setTorque(0.0f);
    return;
  }

  // Haptische tik aan ROM-limieten, met cooldown
  if (graden <= cfg.limiet_min || graden >= cfg.limiet_max) {
    if (millis() - st.laatste_haptic_ms > HAPTIC_COOLDOWN_MS) {
      geefHaptischeTik();
      st.laatste_haptic_ms = millis();
    }
  }

  // ── VIBRATION SUPPRESSION (altijd actief) ────────────────────────────
  // High-pass demping: pakt het verschil tussen instant en LPF-gefilterde
  // velocity. Killt oscillaties bij lichte/loose mounting zonder normale
  // bewegingen te dempen.
  const float vel_hf            = fb.vel - st.gefilterde_vel;
  const float vibration_damping = -cfg.hf_damping_gain * vel_hf;

  // ── SOFT-START ───────────────────────────────────────────────────────
  // De eerste SOFT_START_MS ms na "start" geven we alleen lichte demping
  // en GEEN assist/training-weerstand. Dit voorkomt schokken doordat de
  // patiënt + robot eerst stabiliseren voordat actieve controle inkickt.
  // Tussen SOFT_START_MS en 2x SOFT_START_MS ramp de gain lineair van
  // 0 → 1 (quadratic ease-in voor een zacht inzet).
  const uint32_t since_start = millis() - st.therapie_start_ms;
  const bool     in_soft_start = (since_start < SOFT_START_MS);

  if (in_soft_start) {
    // Pure transparente damping + vibration suppression.
    float doel = -SOFT_START_DAMPING * st.gefilterde_vel + vibration_damping;
    doel = clampf(doel, -cfg.veiligheids_koppel_max,
                         +cfg.veiligheids_koppel_max);
    const float d = doel - st.huidig_koppel;
    if (d > +MAX_KOPPEL_STAP)      st.huidig_koppel += MAX_KOPPEL_STAP;
    else if (d < -MAX_KOPPEL_STAP) st.huidig_koppel -= MAX_KOPPEL_STAP;
    else                            st.huidig_koppel  = doel;
    odrive.setTorque(st.huidig_koppel);
    return;
  }

  // Ease-in van assist over een tweede SOFT_START_MS-venster (0..1, quadratisch)
  float startup_gain = 1.0f;
  if (since_start < 2 * SOFT_START_MS) {
    const float t = (float)(since_start - SOFT_START_MS) / (float)SOFT_START_MS;
    startup_gain = t * t;
  }

  // --- Drie torque-bijdragen ----------------------------------------------
  float assist  = 0.0f;
  float damping = 0.0f;
  float veer    = 0.0f;

  // Virtuele veer buiten ROM (duwt terug naar het bereik)
  if (graden < cfg.limiet_min) {
    veer = (cfg.limiet_min - graden) * cfg.virtuele_veer_stijfheid;
  } else if (graden > cfg.limiet_max) {
    veer = (cfg.limiet_max - graden) * cfg.virtuele_veer_stijfheid;
  }

  // Modus-specifieke logica binnen ROM
  const bool binnen_rom = (graden >= cfg.limiet_min && graden <= cfg.limiet_max);
  if (binnen_rom) {
    switch (st.modus) {

      case ASSISTIVE:
        if (st.gefilterde_vel > VELOCITY_THRESHOLD) {
          // Patiënt buigt actief → boost
          assist  = (st.gefilterde_vel - VELOCITY_THRESHOLD) * cfg.assist_opbouw_factor;
          if (assist > cfg.assist_torque) assist = cfg.assist_torque;
          damping = -BASIS_DAMPING * st.gefilterde_vel;
        } else if (st.gefilterde_vel < -VELOCITY_THRESHOLD) {
          // Patiënt strekt → gecontroleerde weerstand bij terugkeer
          damping = -cfg.assist_strek_weerstand * st.gefilterde_vel;
        } else {
          damping = -BASIS_DAMPING * st.gefilterde_vel;
        }
        break;

      case RESISTIVE:
        if (fabsf(st.gefilterde_vel) > VELOCITY_THRESHOLD) {
          damping = -cfg.training_weerstand * st.gefilterde_vel;
        } else {
          damping = -BASIS_DAMPING * st.gefilterde_vel;
        }
        break;

      case FREERIDE:
      default:
        // Volledig transparant — alleen veer als die buiten ROM zou kicken
        break;
    }
  }

  // Apply soft-start gain op de actieve (richting-gevende) componenten;
  // damping blijft op volle waarde zodat schokjes ook tijdens ramp-in
  // worden gedempt.
  assist *= startup_gain;
  veer   *= startup_gain;

  // Vibration suppression staat altijd aan, in alle modi.
  damping += vibration_damping;

  // Som + harde safety-clamp
  const float doel = clampf(assist + damping + veer,
                            -cfg.veiligheids_koppel_max,
                            +cfg.veiligheids_koppel_max);

  // Slew-rate limiet (geen schokkerige torque-sprongen)
  const float delta = doel - st.huidig_koppel;
  if (delta > +MAX_KOPPEL_STAP)      st.huidig_koppel += MAX_KOPPEL_STAP;
  else if (delta < -MAX_KOPPEL_STAP) st.huidig_koppel -= MAX_KOPPEL_STAP;
  else                                st.huidig_koppel  = doel;

  odrive.setTorque(st.huidig_koppel);
}

// ============================================================================
//   9.  IMU  (MPU-6050, accel-based pitch, ±2 g range)
// ============================================================================
static void imuInit(uint8_t adres) {
  Wire.beginTransmission(adres);
  Wire.write(0x6B); Wire.write(0x00);   // PWR_MGMT_1: wake
  Wire.endTransmission(true);
}

static float imuReadPitchDeg(uint8_t adres) {
  Wire.beginTransmission(adres);
  Wire.write(0x3B);                     // ACCEL_XOUT_H
  Wire.endTransmission(false);
  Wire.requestFrom((int)adres, 6, (int)true);

  const int16_t rawX = (Wire.read() << 8) | Wire.read();
  const int16_t rawY = (Wire.read() << 8) | Wire.read();
  const int16_t rawZ = (Wire.read() << 8) | Wire.read();

  const float aX = rawX / 16384.0f;
  const float aY = rawY / 16384.0f;
  const float aZ = rawZ / 16384.0f;

  return (atan2f(aY, sqrtf(aX * aX + aZ * aZ)) * 180.0f) / PI;
}

// ============================================================================
//   10. ODRIVE HELPERS
// ============================================================================
static void setSysStatus(SysteemStatus s) {
  st.status = s;
}

static void softReset() {
  odrive.setState(AXIS_STATE_IDLE);
  st.hardware_index_turns = 0.0f;
  st.software_nul_turns   = 0.0f;
  st.huidige_doel_turns   = 0.0f;
  st.gefilterde_vel       = 0.0f;
  st.huidig_koppel        = 0.0f;
  setSysStatus(WACHTEN_OP_INDEX);
}

static void modeSwitchPosition() {
  odrive.setPosition(odrive.getFeedback().pos);
  delay(10);
  Serial1.print(F("w axis0.controller.config.control_mode "));
  Serial1.println(ODRV_MODE_POSITION);
  delay(10);
  odrive.setState(AXIS_STATE_CLOSED_LOOP_CONTROL);
}

static void modeSwitchTorque() {
  odrive.setTorque(0.0f);
  delay(10);
  Serial1.print(F("w axis0.controller.config.control_mode "));
  Serial1.println(ODRV_MODE_TORQUE);
  delay(10);
  odrive.setState(AXIS_STATE_CLOSED_LOOP_CONTROL);
}

// Smoothstep-interpolatie tussen twee positions over `duur_s` seconden.
// Blokkerend — alleen tijdens setup/transities, niet in therapie-loop.
static void beweegVloeiend(float van, float naar, float duur_s) {
  const int      kStappen   = 100;
  const uint32_t kStapMs    = (uint32_t)(duur_s * 1000.0f) / kStappen;
  for (int i = 0; i <= kStappen; i++) {
    const float t = (float)i / kStappen;
    const float f = t * t * (3.0f - 2.0f * t);              // smoothstep
    odrive.setPosition(van + (naar - van) * f);
    delay(kStapMs);
  }
}

// ============================================================================
//   11. DRV2605L HAPTIC  (PWM via Timer 4 op pin D13)
// ============================================================================
static void pwmD13_init() {
  TCCR4A = 0; TCCR4B = 5; TCCR4C = 0; TCCR4D = 0;
  PLLFRQ = (PLLFRQ & 0xCF) | 0x30;
  OCR4C  = 255;            // 8-bit top
  OCR4A  = 0;              // duty 0
  DDRC  |= _BV(7);         // D13 als output
  TCCR4A = 0x82;           // OCR4A naar pin, fast-PWM
}

static void drvWriteReg(uint8_t reg, uint8_t val) {
  Wire.beginTransmission(DRV_ADDR);
  Wire.write(reg);
  Wire.write(val);
  Wire.endTransmission();
}

static void drvInit() {
  drvWriteReg(0x01, 0x00);   // uit standby
  drvWriteReg(0x1A, 0xB6);   // LRA mode + closed-loop feedback
  drvWriteReg(0x03, 0x06);   // Library 6 (LRA)
  drvWriteReg(0x01, 0x03);   // input via PWM (D13)
}

static void geefHaptischeTik() {
  int pwm = (int)(255.0f * cfg.haptic_kracht);
  if (pwm > 255) pwm = 255;
  if (pwm < 0)   pwm = 0;
  OCR4A = (uint8_t)pwm;
  delay(HAPTIC_PULSE_MS);
  OCR4A = 0;
}
